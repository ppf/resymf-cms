# Production environment configuration template
# Copy to .env.local and update values

###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=CHANGE_ME_TO_RANDOM_STRING
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DB_DRIVER=pdo_mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=resymf_cms
DB_USER=resymf
DB_PASS=CHANGE_ME
DB_VERSION=mariadb-11.4.0
DB_CHARSET=utf8mb4
###< doctrine/doctrine-bundle ###

###> symfony/routing ###
DEFAULT_URI=https://yourdomain.com
###< symfony/routing ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=smtp://user:pass@smtp.example.com:587
###< symfony/mailer ###

###> symfony/lock ###
LOCK_DSN=redis://redis:6379
###< symfony/lock ###

###> symfony/cache ###
REDIS_URL=redis://redis:6379
###< symfony/cache ###
